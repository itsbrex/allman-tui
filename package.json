{
  "name": "lilac-tui",
  "version": "0.1.0",
  "description": "Terminal UI for the lilac LinkedIn messenger — re-imagined inbox",
  "type": "module",
  "bin": {
    "lilac-tui": "./dist/lilac-tui"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "start": "bun run src/index.tsx",
    "build": "bun run scripts/build.ts",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "ink": "^7.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "react-devtools-core": "^7.0.1",
    "typescript": "^6.0.2"
  }
}
